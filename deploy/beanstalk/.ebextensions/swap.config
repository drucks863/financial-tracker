# The instance is a t4g.nano (512 MB). A 1 GB swap file keeps a memory spike (startup, a big import)
# from getting the JVM killed. Runs on every deploy; does nothing once the swap file exists.
commands:
  01_swap:
    command: |
      if [ ! -f /var/swapfile ]; then
        dd if=/dev/zero of=/var/swapfile bs=1M count=1024
        chmod 600 /var/swapfile
        mkswap /var/swapfile
      fi
      swapon -s | grep -q /var/swapfile || swapon /var/swapfile
