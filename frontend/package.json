{
  "name": "financial-tracker-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "build:server": "vue-tsc --build && vite build --mode server",
    "build:preview": "vue-tsc --build && vite build --mode preview && node scripts/to-artifact.ts",
    "sample-seed": "node scripts/make-sample-seed.ts",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build"
  },
  "dependencies": {
    "@primeuix/themes": "2.0.3",
    "chart.js": "4.5.0",
    "primeicons": "7.0.0",
    "primevue": "4.5.5",
    "vue": "3.5.43",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/tsconfig": "0.9.1",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3",
    "vue-tsc": "3.3.12"
  }
}
